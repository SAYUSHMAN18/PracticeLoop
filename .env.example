# --- LLM provider (change one line to swap) ---
LLM_PROVIDER=groq                  # groq | gemini | bedrock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/practiceloop

# --- Auth ---
SESSION_SECRET=change-me-to-a-random-string

# --- Pipeline ---
LLM_MIN_INTERVAL_SECONDS=2.1
