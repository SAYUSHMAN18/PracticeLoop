# --- LLM provider (change one line to swap) ---
LLM_PROVIDER=groq                  # groq | gemini | bedrock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/practiceloop

# --- Auth ---
SESSION_SECRET=change-me-to-a-random-string

# --- Pipeline ---
LLM_MIN_INTERVAL_SECONDS=2.1
# LLM_DAILY_BUDGET=20                # per-user cap across /practice/structure and
                                    # /practice/study-card, see app/core/llm_budget.py

# --- Deployment ---
APP_ENV=development                # development | production -- gates HSTS and the
                                    # session-secret boot check, see app/core/config.py
# WEB_CONCURRENCY=1                # uvicorn worker count; each loads its own copy of the
                                    # embedding model, so this trades memory for throughput

# --- Jobs (Phase 1: scheduled discovery) ---
# JOBS_CRON_TOKEN=                 # required to call POST /jobs/cron/discover; also set as
                                    # the JOBS_CRON_TOKEN secret in GitHub Actions
# ADZUNA_APP_ID=                   # free at developer.adzuna.com -- discovery is a no-op
# ADZUNA_APP_KEY=                  # with no source configured, not an error
# ADZUNA_COUNTRY=in                # Adzuna's country code, e.g. in | us | gb
# JOBS_MAX_LISTINGS_PER_USER=25    # per source, per run
