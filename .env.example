# --- LLM provider (change one line to swap) ---
LLM_PROVIDER=groq                  # groq | gemini | bedrock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=
# LLM_FALLBACK_PROVIDER=           # if the primary errors after its retries, try this
                                    # one once. "" = no failover. Only useful if its key
                                    # is also set (e.g. PROVIDER=groq, FALLBACK=gemini).

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/practiceloop

# --- Auth ---
SESSION_SECRET=change-me-to-a-random-string
# LOGIN_LOCKOUT_THRESHOLD=8        # consecutive failed logins that lock an account
# LOGIN_LOCKOUT_MINUTES=15         # how long it stays locked; any success clears the count

# --- Email (password reset, verification, review-reminder digest) ---
# EMAIL_BACKEND=console            # console | resend | smtp. console just logs --
                                    # every flow works end to end, it just never
                                    # delivers. resend is the easy path (one key).
# EMAIL_FROM=                      # e.g. "PracticeLoop <no-reply@yourdomain.com>"
# RESEND_API_KEY=                  # EMAIL_BACKEND=resend -- free tier at resend.com,
                                    # no SMTP host/port/TLS to get wrong
# DIGEST_CRON_TOKEN=               # bearer token for POST /cron/digest; also set as the
                                    # DIGEST_CRON_TOKEN secret in GitHub Actions. Unset =
                                    # the endpoint 503s (fail closed).
# EMAIL_FROM=
# SMTP_HOST=                       # any provider speaks SMTP: Gmail, SES, Postmark,
# SMTP_PORT=587                    # Resend, Mailgun, Fastmail, a local relay...
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_STARTTLS=true
# SMTP_USE_SSL=false               # true for an implicit-TLS port (usually 465)

# --- Pipeline ---
# LLM_MIN_INTERVAL_SECONDS=0.4     # courtesy floor between the *starts* of two outbound
                                    # calls. No longer serializes the process -- up to
                                    # LLM_MAX_CONCURRENCY run at once (see app/core/llm.py)
# LLM_MAX_CONCURRENCY=4            # simultaneous outbound LLM calls, whole deployment
# LLM_PER_USER_CONCURRENCY=2       # ... and per user, so one account can't take every slot
# LLM_CACHE_TTL_DAYS=30            # identical no-user-data prompts served from llm_cache
# LLM_DAILY_BUDGET=20              # per-user cap across every AI-backed route,
                                    # see app/core/llm_budget.py
# LLM_GLOBAL_DAILY_BUDGET=0        # deployment-wide ceiling across ALL users. 0 = off,
                                    # which is right for a single-user install. Set a real
                                    # number on any public deploy with open signup: the
                                    # per-user cap alone leaves N users x LLM_DAILY_BUDGET
                                    # unbounded against one shared provider key.

# --- Observability ---
# SENTRY_DSN=                      # unset = error reporting off entirely. Needs the
                                    # optional extra: pip install -e ".[sentry]"
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Deployment ---
APP_ENV=development                # development | production -- gates HSTS and the
                                    # session-secret boot check, see app/core/config.py
# WEB_CONCURRENCY=1                # uvicorn worker count; each loads its own copy of the
                                    # embedding model, so this trades memory for throughput

# --- Jobs (Phase 1: scheduled discovery) ---
# JOBS_CRON_TOKEN=                 # required to call POST /jobs/cron/discover; also set as
                                    # the JOBS_CRON_TOKEN secret in GitHub Actions
# ADZUNA_APP_ID=                   # free at developer.adzuna.com -- discovery is a no-op
# ADZUNA_APP_KEY=                  # with no source configured, not an error
# ADZUNA_COUNTRY=in                # Adzuna's country code, e.g. in | us | gb
# JOBS_MAX_LISTINGS_PER_USER=25    # per source, per run
